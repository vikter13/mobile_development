<Window x:Class="ImageEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Editor" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="10">
            <Button Content="Загрузить картинку" Name="LoadImageButton" 
                    Margin="0,5" Padding="5" Click="LoadImageButton_Click"/>
            
            <GroupBox Header="Настройки сетки" Margin="0,10">
                <StackPanel>
                    <TextBlock Text="Рядов:" Margin="0,10,0,0"/>
                    <ComboBox Name="RowsComboBox" Margin="0,5" 
                              SelectionChanged="GridSettings_Changed"/>
                    
                    <TextBlock Text="Колонок:" Margin="0,10,0,0"/>
                    <ComboBox Name="ColumnsComboBox" Margin="0,5" 
                              SelectionChanged="GridSettings_Changed"/>
                    
                    <TextBlock Text="Отступы горизонтальные:" Margin="0,10,0,0"/>
                    <ComboBox Name="HorizontalPaddingComboBox" Margin="0,5" 
                              SelectionChanged="GridSettings_Changed"/>
                    
                    <TextBlock Text="Отступы вертикальные:" Margin="0,10,0,0"/>
                    <ComboBox Name="VerticalPaddingComboBox" Margin="0,5" 
                              SelectionChanged="GridSettings_Changed"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Поворот" Margin="0,10">
                <StackPanel>
                    <Slider Name="RotationSlider" Minimum="-90" Maximum="90" 
                            Value="0" TickFrequency="5" IsSnapToTickEnabled="True"
                            ValueChanged="RotationSlider_ValueChanged"/>
                    <TextBlock Text="{Binding ElementName=RotationSlider, Path=Value, 
                               StringFormat='{}{0:F1}°'}" HorizontalAlignment="Center"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Информация" Margin="0,10">
                <StackPanel>
                    <TextBlock Name="ImageInfoTextBlock" TextWrapping="Wrap"/>
                    <TextBlock Name="SelectionInfoTextBlock" TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>

            <Button Content="Сохранить области" Name="SaveAreasButton" 
                    Margin="0,10,0,5" Padding="5" Click="SaveAreasButton_Click"/>
            
            <Button Content="Сохранить настройки" Name="SaveSettingsButton" 
                    Margin="0,5" Padding="5" Click="SaveSettingsButton_Click"/>
            
            <Button Content="Загрузить настройки" Name="LoadSettingsButton" 
                    Margin="0,5" Padding="5" Click="LoadSettingsButton_Click"/>
        </StackPanel>

        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Background="LightGray"
                      MouseWheel="ScrollViewer_MouseWheel"
                      MouseRightButtonDown="ScrollViewer_MouseRightButtonDown"
                      MouseRightButtonUp="ScrollViewer_MouseRightButtonUp"
                      MouseMove="ScrollViewer_MouseMove">
            <Grid Name="ImageGrid">
                <Image Name="MainImage" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <RotateTransform x:Name="ImageRotation"/>
                            <ScaleTransform x:Name="ImageScale"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
                <Canvas Name="SelectionCanvas" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
