<Window x:Class="kursach_wpf.QuizWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quiz" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid Background="#34495E">
        <TextBlock Name="QuizTitle" FontSize="36" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20" />
        <Button Content="Complete Quiz" Width="200" Height="50" VerticalAlignment="Center" HorizontalAlignment="Center" Click="CompleteQuiz_Click" />
    </Grid>
</Window>
