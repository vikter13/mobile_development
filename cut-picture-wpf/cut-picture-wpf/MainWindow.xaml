<Window x:Class="CutPictureWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cut Picture" Height="600" Width="800">
    <Grid>
        <Image x:Name="ImageControl" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Button Content="Load Image" HorizontalAlignment="Left" VerticalAlignment="Top" Width="100" Height="30" Margin="10" Click="LoadImageButton_Click"/>
        <Button Content="Save Area" HorizontalAlignment="Left" VerticalAlignment="Top" Width="100" Height="30" Margin="10,40,0,0" Click="SaveAreaButton_Click"/>
        <Slider x:Name="ZoomSlider" HorizontalAlignment="Left" VerticalAlignment="Top" Width="200" Height="30" Margin="10,80,0,0" Minimum="0.1" Maximum="5" Value="1" TickFrequency="0.1" ValueChanged="ZoomSlider_ValueChanged"/>
        <TextBlock x:Name="ImageInfoText" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,120,0,0"/>
    </Grid>
</Window>
